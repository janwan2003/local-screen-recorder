{
  "manifest_version": 3,
  "name": "Diskreel: Screen Recorder to MP4, No Account",
  "short_name": "Diskreel",
  "version": "0.1.0",
  "description": "Record your screen, a window or a tab with webcam and mic. Saves MP4 to your disk. No account, no upload, no watermark, no limits.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open Diskreel recorder", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Open the recorder" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
